---
/* Arabesco da fachada — filigrana simétrica usada acima e abaixo dos
   filetes do logotipo e como divisor de seção.
   `flip` inverte na vertical (versão que fica sob o filete). */
const { width = 150, flip = false, class: extra = "" } = Astro.props;
const classes = ["orn", flip ? "orn--flip" : "", extra].filter(Boolean).join(" ");
---

<svg
  class={classes}
  viewBox="0 0 200 46"
  width={width}
  height={Math.round((width * 46) / 200)}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- haste central e folha -->
  <path d="M100 42V26" />
  <path d="M100 7c4.4 5 4.4 11.4 0 16.4-4.4-5-4.4-11.4 0-16.4Z" fill="currentColor" stroke="none" />
  <circle cx="100" cy="25.5" r="2.1" fill="currentColor" stroke="none" />

  <!-- metade direita -->
  <g>
    <path d="M100 41c9.6 0 15.6-3.4 21-9.6 5.6-6.4 12.4-11 20.6-8.6 7 2 9.2 9.4 4.6 13.6-3.8 3.4-9.8 2-10.6-2.8-.6-3.6 2.4-6.6 6-6" />
    <path d="M100 41c7.8 2.4 15 2.6 21.6-.6" />
    <path d="M146.2 22.8c6-4.4 14.4-4 19.6 1 3.4 3.2 3.6 8.2.4 10.8" />
    <path d="M168 20.4c6.6-.6 12.4 1.8 16.6 6.6" />
  </g>

  <!-- metade esquerda (espelhada) -->
  <g transform="translate(200,0) scale(-1,1)">
    <path d="M100 41c9.6 0 15.6-3.4 21-9.6 5.6-6.4 12.4-11 20.6-8.6 7 2 9.2 9.4 4.6 13.6-3.8 3.4-9.8 2-10.6-2.8-.6-3.6 2.4-6.6 6-6" />
    <path d="M100 41c7.8 2.4 15 2.6 21.6-.6" />
    <path d="M146.2 22.8c6-4.4 14.4-4 19.6 1 3.4 3.2 3.6 8.2.4 10.8" />
    <path d="M168 20.4c6.6-.6 12.4 1.8 16.6 6.6" />
  </g>
</svg>
