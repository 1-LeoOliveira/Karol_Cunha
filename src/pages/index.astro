---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Sobre from "../components/Sobre.astro";
import Procedimentos from "../components/Procedimentos.astro";
import Experiencia from "../components/Experiencia.astro";
import Depoimentos from "../components/Depoimentos.astro";
import CursosVip from "../components/CursosVip.astro";
import Galeria from "../components/Galeria.astro";
import Contato from "../components/Contato.astro";
